generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model accidents {
  id               BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  vehicle_id       BigInt             @db.UnsignedBigInt
  driver_id        BigInt?            @db.UnsignedBigInt
  rental_id        BigInt?            @db.UnsignedBigInt
  accident_date    DateTime           @db.DateTime(0)
  location         String?            @db.VarChar(255)
  description      String?            @db.Text
  police_report_no String?            @db.VarChar(100)
  estimated_damage Decimal?           @db.Decimal(12, 2)
  status           accidents_status   @default(reported)
  created_at       DateTime           @default(now()) @db.Timestamp(0)
  updated_at       DateTime           @default(now()) @db.Timestamp(0)
  drivers          drivers?           @relation(fields: [driver_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "accidents_driver_id_foreign")
  rentals          rentals?           @relation(fields: [rental_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "accidents_rental_id_foreign")
  vehicles         vehicles           @relation(fields: [vehicle_id], references: [id], onUpdate: Restrict, map: "accidents_vehicle_id_foreign")
  insurance_claims insurance_claims[]

  @@index([accident_date], map: "accidents_accident_date_index")
  @@index([driver_id], map: "accidents_driver_id_index")
  @@index([rental_id], map: "accidents_rental_id_index")
  @@index([status], map: "accidents_status_index")
  @@index([vehicle_id], map: "accidents_vehicle_id_index")
}

model alert_history {
  id                  BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  rule_id             BigInt?                @db.UnsignedBigInt
  event_type          String                 @db.VarChar(100)
  title               String                 @db.VarChar(200)
  severity            alert_history_severity @default(info)
  message             String?                @db.Text
  related_entity_type String?                @db.VarChar(100)
  related_entity_id   BigInt?                @db.UnsignedBigInt
  resolved_at         DateTime?              @db.DateTime(0)
  resolved_by         BigInt?                @db.UnsignedBigInt
  created_at          DateTime               @default(now()) @db.Timestamp(0)
  updated_at          DateTime               @default(now()) @db.Timestamp(0)
  users               users?                 @relation(fields: [resolved_by], references: [id], onUpdate: Restrict, map: "alert_history_resolved_by_foreign")
  notification_rules  notification_rules?    @relation(fields: [rule_id], references: [id], onUpdate: Restrict, map: "alert_history_rule_id_foreign")

  @@index([event_type], map: "alert_history_event_type_index")
  @@index([related_entity_type, related_entity_id], map: "alert_history_related_entity_type_related_entity_id_index")
  @@index([resolved_at], map: "alert_history_resolved_at_index")
  @@index([resolved_by], map: "alert_history_resolved_by_index")
  @@index([rule_id], map: "alert_history_rule_id_index")
  @@index([severity], map: "alert_history_severity_index")
}

model audit_logs {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  user_id     BigInt?  @db.UnsignedBigInt
  module      String   @db.VarChar(100)
  action      String   @db.VarChar(100)
  entity_type String?  @db.VarChar(100)
  entity_id   BigInt?  @db.UnsignedBigInt
  old_values  String?  @db.LongText
  new_values  String?  @db.LongText
  ip_address  String?  @db.VarChar(50)
  user_agent  String?  @db.Text
  created_at  DateTime @default(now()) @db.Timestamp(0)
  users       users?   @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "audit_logs_user_id_foreign")

  @@index([action], map: "audit_logs_action_index")
  @@index([created_at], map: "audit_logs_created_at_index")
  @@index([entity_type, entity_id], map: "audit_logs_entity_type_entity_id_index")
  @@index([module], map: "audit_logs_module_index")
  @@index([user_id], map: "audit_logs_user_id_index")
}

model document_versions {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  document_id    BigInt    @db.UnsignedBigInt
  version_number Int       @default(1)
  file_url       String    @db.VarChar(500)
  file_size      Int?      @db.UnsignedInt
  uploaded_by    BigInt?   @db.UnsignedBigInt
  change_summary String?   @db.Text
  created_at     DateTime  @default(now()) @db.Timestamp(0)
  updated_at     DateTime  @default(now()) @db.Timestamp(0)
  documents      documents @relation(fields: [document_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "document_versions_document_id_foreign")
  users          users?    @relation(fields: [uploaded_by], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "document_versions_uploaded_by_foreign")

  @@index([document_id], map: "document_versions_document_id_index")
  @@index([uploaded_by], map: "document_versions_uploaded_by_index")
}

model documents {
  id                BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  title             String              @db.VarChar(255)
  document_type     String              @db.VarChar(100)
  file_url          String              @db.VarChar(500)
  file_size         Int?                @db.UnsignedInt
  mime_type         String?             @db.VarChar(100)
  vehicle_id        BigInt?             @db.UnsignedBigInt
  driver_id         BigInt?             @db.UnsignedBigInt
  rental_id         BigInt?             @db.UnsignedBigInt
  uploaded_by       BigInt?             @db.UnsignedBigInt
  expiry_date       DateTime?           @db.Date
  notes             String?             @db.Text
  created_at        DateTime            @default(now()) @db.Timestamp(0)
  updated_at        DateTime            @default(now()) @db.Timestamp(0)
  document_versions document_versions[]
  drivers           drivers?            @relation(fields: [driver_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "documents_driver_id_foreign")
  rentals           rentals?            @relation(fields: [rental_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "documents_rental_id_foreign")
  users             users?              @relation(fields: [uploaded_by], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "documents_uploaded_by_foreign")
  vehicles          vehicles?           @relation(fields: [vehicle_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "documents_vehicle_id_foreign")

  @@index([document_type], map: "documents_document_type_index")
  @@index([driver_id], map: "documents_driver_id_index")
  @@index([expiry_date], map: "documents_expiry_date_index")
  @@index([rental_id], map: "documents_rental_id_index")
  @@index([uploaded_by], map: "documents_uploaded_by_index")
  @@index([vehicle_id], map: "documents_vehicle_id_index")
}

model drivers {
  id                  BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  first_name          String                @db.VarChar(100)
  last_name           String                @db.VarChar(100)
  email               String?               @db.VarChar(255)
  phone               String?               @db.VarChar(50)
  license_number      String?               @db.VarChar(100)
  license_state       String?               @db.VarChar(10)
  license_expiry      DateTime?             @db.Date
  status              drivers_status        @default(pending)
  balance             Decimal               @default(0.00) @db.Decimal(12, 2)
  deposit_held        Decimal               @default(0.00) @db.Decimal(12, 2)
  notes               String?               @db.Text
  archived_at         DateTime?             @db.Timestamp(0)
  created_at          DateTime              @default(now()) @db.Timestamp(0)
  updated_at          DateTime              @default(now()) @db.Timestamp(0)
  accidents           accidents[]
  documents           documents[]
  employee_paperwork  employee_paperwork[]
  invoices            invoices[]
  ledger_entries      ledger_entries[]
  rentals             rentals[]
  tolls_tickets       tolls_tickets[]
  vehicle_assignments vehicle_assignments[]

  @@index([archived_at], map: "drivers_archived_at_index")
  @@index([email], map: "drivers_email_index")
  @@index([license_expiry], map: "drivers_license_expiry_index")
  @@index([license_number], map: "drivers_license_number_index")
  @@index([status], map: "drivers_status_index")
}

model employee_paperwork {
  id                                          BigInt                    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id                                     BigInt?                   @db.UnsignedBigInt
  driver_id                                   BigInt?                   @db.UnsignedBigInt
  full_name                                   String                    @db.VarChar(200)
  ssn_last4                                   String?                   @db.VarChar(4)
  dob                                         DateTime?                 @db.Date
  address                                     String?                   @db.Text
  phone                                       String?                   @db.VarChar(50)
  emergency_contact                           String?                   @db.LongText
  direct_deposit_details                      String?                   @db.LongText
  status                                      employee_paperwork_status @default(draft)
  submitted_at                                DateTime?                 @db.DateTime(0)
  reviewed_by                                 BigInt?                   @db.UnsignedBigInt
  review_notes                                String?                   @db.Text
  signature_url                               String?                   @db.VarChar(500)
  created_at                                  DateTime                  @default(now()) @db.Timestamp(0)
  updated_at                                  DateTime                  @default(now()) @db.Timestamp(0)
  drivers                                     drivers?                  @relation(fields: [driver_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "employee_paperwork_driver_id_foreign")
  users_employee_paperwork_reviewed_byTousers users?                    @relation("employee_paperwork_reviewed_byTousers", fields: [reviewed_by], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "employee_paperwork_reviewed_by_foreign")
  users_employee_paperwork_user_idTousers     users?                    @relation("employee_paperwork_user_idTousers", fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "employee_paperwork_user_id_foreign")

  @@index([driver_id], map: "employee_paperwork_driver_id_index")
  @@index([reviewed_by], map: "employee_paperwork_reviewed_by_index")
  @@index([status], map: "employee_paperwork_status_index")
  @@index([submitted_at], map: "employee_paperwork_submitted_at_index")
  @@index([user_id], map: "employee_paperwork_user_id_index")
}

model expenses {
  id                                BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  vehicle_id                        BigInt?           @db.UnsignedBigInt
  vendor_id                         BigInt?           @db.UnsignedBigInt
  rental_id                         BigInt?           @db.UnsignedBigInt
  recorded_by                       BigInt?           @db.UnsignedBigInt
  approver_id                       BigInt?           @db.UnsignedBigInt
  category                          expenses_category
  amount                            Decimal           @db.Decimal(12, 2)
  expense_date                      DateTime          @db.Date
  payment_method                    String?           @db.VarChar(100)
  invoice_receipt_url               String?           @db.VarChar(500)
  description                       String?           @db.Text
  status                            expenses_status   @default(pending)
  created_at                        DateTime          @default(now()) @db.Timestamp(0)
  updated_at                        DateTime          @default(now()) @db.Timestamp(0)
  users_expenses_approver_idTousers users?            @relation("expenses_approver_idTousers", fields: [approver_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "expenses_approver_id_foreign")
  users_expenses_recorded_byTousers users?            @relation("expenses_recorded_byTousers", fields: [recorded_by], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "expenses_recorded_by_foreign")
  rentals                           rentals?          @relation(fields: [rental_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "expenses_rental_id_foreign")
  vehicles                          vehicles?         @relation(fields: [vehicle_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "expenses_vehicle_id_foreign")
  vendors                           vendors?          @relation(fields: [vendor_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "expenses_vendor_id_foreign")

  @@index([approver_id], map: "expenses_approver_id_foreign")
  @@index([category], map: "expenses_category_index")
  @@index([expense_date], map: "expenses_expense_date_index")
  @@index([recorded_by], map: "expenses_recorded_by_foreign")
  @@index([rental_id], map: "expenses_rental_id_index")
  @@index([status], map: "expenses_status_index")
  @@index([vehicle_id], map: "expenses_vehicle_id_index")
  @@index([vendor_id], map: "expenses_vendor_id_index")
}

model inspection_photos {
  id            BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  inspection_id BigInt                @db.UnsignedBigInt
  photo_url     String                @db.VarChar(500)
  caption       String?               @db.VarChar(255)
  tag           inspection_photos_tag @default(other)
  created_at    DateTime              @default(now()) @db.Timestamp(0)
  updated_at    DateTime              @default(now()) @db.Timestamp(0)
  inspections   inspections           @relation(fields: [inspection_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "inspection_photos_inspection_id_foreign")

  @@index([inspection_id], map: "inspection_photos_inspection_id_index")
  @@index([tag], map: "inspection_photos_tag_index")
}

model inspections {
  id                  BigInt                      @id @default(autoincrement()) @db.UnsignedBigInt
  rental_id           BigInt?                     @db.UnsignedBigInt
  vehicle_id          BigInt                      @db.UnsignedBigInt
  inspector_id        BigInt?                     @db.UnsignedBigInt
  inspection_type     inspections_inspection_type
  inspection_date     DateTime                    @db.DateTime(0)
  odometer            Int
  fuel_level          String?                     @db.VarChar(50)
  condition_checklist String?                     @db.LongText
  notes               String?                     @db.Text
  driver_acknowledged Boolean                     @default(false)
  created_at          DateTime                    @default(now()) @db.Timestamp(0)
  updated_at          DateTime                    @default(now()) @db.Timestamp(0)
  inspection_photos   inspection_photos[]
  users               users?                      @relation(fields: [inspector_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "inspections_inspector_id_foreign")
  rentals             rentals?                    @relation(fields: [rental_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "inspections_rental_id_foreign")
  vehicles            vehicles                    @relation(fields: [vehicle_id], references: [id], onUpdate: Restrict, map: "inspections_vehicle_id_foreign")

  @@index([inspection_date], map: "inspections_inspection_date_index")
  @@index([inspection_type], map: "inspections_inspection_type_index")
  @@index([inspector_id], map: "inspections_inspector_id_index")
  @@index([rental_id], map: "inspections_rental_id_index")
  @@index([vehicle_id], map: "inspections_vehicle_id_index")
}

model insurance_claims {
  id                  BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  policy_id           BigInt?                 @db.UnsignedBigInt
  accident_id         BigInt?                 @db.UnsignedBigInt
  vehicle_id          BigInt?                 @db.UnsignedBigInt
  claim_number        String                  @db.VarChar(100)
  claim_date          DateTime                @db.Date
  claim_amount        Decimal                 @db.Decimal(12, 2)
  payout_amount       Decimal                 @default(0.00) @db.Decimal(12, 2)
  deductible_applied  Decimal                 @default(0.00) @db.Decimal(12, 2)
  status              insurance_claims_status @default(submitted)
  notes               String?                 @db.Text
  created_at          DateTime                @default(now()) @db.Timestamp(0)
  updated_at          DateTime                @default(now()) @db.Timestamp(0)
  accident_ref        String?                 @db.VarChar(100)
  policy_number       String?                 @db.VarChar(100)
  insurer             String?                 @db.VarChar(150)
  vehicle             String?                 @db.VarChar(150)
  plate               String?                 @db.VarChar(50)
  driver              String?                 @db.VarChar(150)
  repair_invoice      String?                 @db.VarChar(150)
  repair_invoice_file String?                 @db.VarChar(255)
  repair_estimate     Decimal?                @db.Decimal(12, 2)
  deductible_terms    String?                 @db.VarChar(150)
  driver_charge       Decimal?                @default(0.00) @db.Decimal(12, 2)
  driver_recovered    Decimal?                @default(0.00) @db.Decimal(12, 2)
  amount_recovered    Decimal?                @default(0.00) @db.Decimal(12, 2)
  adjuster_name       String?                 @db.VarChar(150)
  adjuster_phone      String?                 @db.VarChar(100)
  accidents           accidents?              @relation(fields: [accident_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "insurance_claims_accident_id_foreign")
  insurance_policies  insurance_policies?     @relation(fields: [policy_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "insurance_claims_policy_id_foreign")
  vehicles            vehicles?               @relation(fields: [vehicle_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "insurance_claims_vehicle_id_foreign")

  @@index([accident_id], map: "insurance_claims_accident_id_index")
  @@index([claim_number], map: "insurance_claims_claim_number_index")
  @@index([policy_id], map: "insurance_claims_policy_id_index")
  @@index([status], map: "insurance_claims_status_index")
  @@index([vehicle_id], map: "insurance_claims_vehicle_id_index")
}

model insurance_policies {
  id               BigInt                    @id @default(autoincrement()) @db.UnsignedBigInt
  vehicle_id       BigInt?                   @db.UnsignedBigInt
  policy_number    String                    @db.VarChar(100)
  insurer_name     String                    @db.VarChar(150)
  coverage_type    String                    @db.VarChar(100)
  premium          Decimal                   @db.Decimal(12, 2)
  deductible       Decimal                   @default(0.00) @db.Decimal(12, 2)
  effective_date   DateTime                  @db.Date
  expiry_date      DateTime                  @db.Date
  status           insurance_policies_status @default(active)
  created_at       DateTime                  @default(now()) @db.Timestamp(0)
  updated_at       DateTime                  @default(now()) @db.Timestamp(0)
  coverage_details String?                   @db.Text
  vehicles_covered String?                   @db.VarChar(150)
  contacts         String?                   @db.LongText
  documents        String?                   @db.LongText
  insurance_claims insurance_claims[]
  vehicles         vehicles?                 @relation(fields: [vehicle_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "insurance_policies_vehicle_id_foreign")

  @@index([expiry_date], map: "insurance_policies_expiry_date_index")
  @@index([policy_number], map: "insurance_policies_policy_number_index")
  @@index([status], map: "insurance_policies_status_index")
  @@index([vehicle_id], map: "insurance_policies_vehicle_id_index")
}

model invitations {
  id          BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  email       String           @db.VarChar(255)
  role        invitations_role
  token       String           @unique(map: "invitations_token_unique") @db.VarChar(255)
  invited_by  BigInt?          @db.UnsignedBigInt
  expires_at  DateTime         @default(now()) @db.Timestamp(0)
  accepted_at DateTime?        @db.Timestamp(0)
  created_at  DateTime         @default(now()) @db.Timestamp(0)
  updated_at  DateTime         @default(now()) @db.Timestamp(0)
  users       users?           @relation(fields: [invited_by], references: [id], onUpdate: Restrict, map: "invitations_invited_by_foreign")

  @@index([email], map: "invitations_email_index")
  @@index([invited_by], map: "invitations_invited_by_index")
}

model invoice_items {
  id          BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  invoice_id  BigInt                  @db.UnsignedBigInt
  description String                  @db.VarChar(255)
  category    invoice_items_category?
  quantity    Decimal                 @default(1.00) @db.Decimal(8, 2)
  unit_price  Decimal                 @db.Decimal(12, 2)
  amount      Decimal                 @db.Decimal(12, 2)
  created_at  DateTime                @default(now()) @db.Timestamp(0)
  updated_at  DateTime                @default(now()) @db.Timestamp(0)
  invoices    invoices                @relation(fields: [invoice_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "invoice_items_invoice_id_foreign")

  @@index([invoice_id], map: "invoice_items_invoice_id_index")
}

model invoices {
  id             BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  invoice_number String           @unique(map: "invoices_invoice_number_unique") @db.VarChar(100)
  rental_id      BigInt?          @db.UnsignedBigInt
  driver_id      BigInt?          @db.UnsignedBigInt
  issued_by      BigInt?          @db.UnsignedBigInt
  issue_date     DateTime         @db.Date
  due_date       DateTime         @db.Date
  subtotal       Decimal          @db.Decimal(12, 2)
  tax            Decimal          @default(0.00) @db.Decimal(12, 2)
  total_amount   Decimal          @db.Decimal(12, 2)
  paid_amount    Decimal          @default(0.00) @db.Decimal(12, 2)
  balance        Decimal          @default(0.00) @db.Decimal(12, 2)
  status         invoices_status  @default(draft)
  created_at     DateTime         @default(now()) @db.Timestamp(0)
  updated_at     DateTime         @default(now()) @db.Timestamp(0)
  customer_name  String?          @db.VarChar(150)
  vehicle_name   String?          @db.VarChar(150)
  notes          String?          @db.Text
  invoice_items  invoice_items[]
  drivers        drivers?         @relation(fields: [driver_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "invoices_driver_id_foreign")
  users          users?           @relation(fields: [issued_by], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "invoices_issued_by_foreign")
  rentals        rentals?         @relation(fields: [rental_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "invoices_rental_id_foreign")
  ledger_entries ledger_entries[]
  tolls_tickets  tolls_tickets[]

  @@index([driver_id], map: "invoices_driver_id_index")
  @@index([due_date], map: "invoices_due_date_index")
  @@index([issue_date], map: "invoices_issue_date_index")
  @@index([issued_by], map: "invoices_issued_by_index")
  @@index([rental_id], map: "invoices_rental_id_index")
  @@index([status], map: "invoices_status_index")
}

model knex_migrations {
  id             Int      @id @default(autoincrement()) @db.UnsignedInt
  name           String?  @db.VarChar(255)
  batch          Int?
  migration_time DateTime @default(now()) @db.Timestamp(0)
}

model knex_migrations_lock {
  index     Int  @id @default(autoincrement()) @db.UnsignedInt
  is_locked Int?
}

model ledger_entries {
  id             BigInt                         @id @default(autoincrement()) @db.UnsignedBigInt
  rental_id      BigInt?                        @db.UnsignedBigInt
  driver_id      BigInt?                        @db.UnsignedBigInt
  invoice_id     BigInt?                        @db.UnsignedBigInt
  recorded_by    BigInt?                        @db.UnsignedBigInt
  entry_type     ledger_entries_entry_type
  amount         Decimal                        @db.Decimal(12, 2)
  payment_method ledger_entries_payment_method?
  reference_no   String?                        @db.VarChar(100)
  notes          String?                        @db.Text
  entry_date     DateTime                       @db.DateTime(0)
  created_at     DateTime                       @default(now()) @db.Timestamp(0)
  updated_at     DateTime                       @default(now()) @db.Timestamp(0)
  category       String?                        @db.VarChar(100)
  description    String?                        @db.Text
  status         String?                        @default("Posted") @db.VarChar(50)
  qbo_ref        String?                        @db.VarChar(100)
  driver_name    String?                        @db.VarChar(150)
  rental_code    String?                        @db.VarChar(100)
  metadata       String?                        @db.LongText
  drivers        drivers?                       @relation(fields: [driver_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "ledger_entries_driver_id_foreign")
  invoices       invoices?                      @relation(fields: [invoice_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "ledger_entries_invoice_id_foreign")
  users          users?                         @relation(fields: [recorded_by], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "ledger_entries_recorded_by_foreign")
  rentals        rentals?                       @relation(fields: [rental_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "ledger_entries_rental_id_foreign")

  @@index([driver_id], map: "ledger_entries_driver_id_index")
  @@index([entry_date], map: "ledger_entries_entry_date_index")
  @@index([entry_type], map: "ledger_entries_entry_type_index")
